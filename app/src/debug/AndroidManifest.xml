<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug-only adb entry point for the process-death recovery test.
             Exported for `adb shell am broadcast`, but guarded by DUMP, which
             the shell holds and third-party apps cannot: debug builds are
             daily drivers, and without it any installed app could seed
             downloads, flip the export setting or delete MediaStore rows. -->
        <receiver
            android:name=".download.DownloadTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.music.bitchord.debug.SEED_DOWNLOAD_DEATH_TEST" />
                <action android:name="com.music.bitchord.debug.VERIFY_DOWNLOAD_DEATH_TEST" />
                <action android:name="com.music.bitchord.debug.CLEAN_DOWNLOAD_DEATH_TEST" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
