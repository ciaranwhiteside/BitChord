<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto-backup rules for Android 11 and older; data_extraction_rules.xml
   replaces these from Android 12.

   The encrypted stores are excluded because their keysets are wrapped by an
   Android Keystore key that never leaves the device: restored anywhere, they
   can't be decrypted (see EncryptedPrefs). Their plain fallbacks are excluded
   because they hold the same credentials in cleartext.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="bitchord_auth.xml" />
    <exclude domain="sharedpref" path="bitchord_auth_plain.xml" />
    <exclude domain="sharedpref" path="bitchord_sources.xml" />
    <exclude domain="sharedpref" path="bitchord_sources_plain.xml" />
    <!-- Addon token and tester code: credentials for this phone's owner
         (see AddonAuth). The *_secure files are the encrypted stores; the
         unsuffixed names are the legacy plain files they migrate from and the
         fallback when the Keystore is unusable. -->
    <exclude domain="sharedpref" path="bitchord_tester.xml" />
    <exclude domain="sharedpref" path="bitchord_tester_secure.xml" />
    <exclude domain="sharedpref" path="bitchord_addon_auth.xml" />
    <exclude domain="sharedpref" path="bitchord_addon_auth_secure.xml" />
    <!-- Playback queues are local session state; do not resurrect them after reinstall. -->
    <exclude domain="sharedpref" path="bitchord_last_played.xml" />
    <exclude domain="sharedpref" path="bitchord_bounded_context.xml" />
    <exclude domain="sharedpref" path="bitchord_party_queue_stash.xml" />
    <!-- Party pseudonym key (Keystore-bound) and party server/token/device
         identity: session state, not backup data. -->
    <exclude domain="sharedpref" path="bitchord_party_secret.xml" />
    <exclude domain="sharedpref" path="bitchord_party_secret_plain.xml" />
    <exclude domain="sharedpref" path="bitchord_listen_together.xml" />
    <!-- Drive backup: the account grant belongs to this phone (see DriveBackup). -->
    <exclude domain="sharedpref" path="bitchord_drive_backup.xml" />
    <!-- Other devices' listening and what this one last uploaded: Drive sync's, and re-fetched from Drive. -->
    <exclude domain="file" path="listening-peers/" />
    <exclude domain="file" path="listening-synced/" />
</full-backup-content>
